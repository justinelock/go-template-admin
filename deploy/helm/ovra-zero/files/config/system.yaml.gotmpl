RestConf:
  Mode: dev
  Name: system
  Port: 8086
  Log:
    ServiceName: system-api
  Prometheus:
    Port: 4002

Tenant:
  Enabled: true
  IgnoreTables:
    - sys_tenant
    - sys_tenant_package
    - sys_menu
    - sys_user_role
    - sys_user_post
    - sys_role_menu
    - sys_role_dept
    - sys_client
    - sys_config
